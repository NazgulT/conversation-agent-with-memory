# .env.example — commit this file, fill in .env with real values

# ── LLM Provider Switch ─────────────────────────────────────────
# Set to: ollama | huggingface
LLM_PROVIDER=ollama

# ── Ollama Config (used when LLM_PROVIDER=ollama) ───────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MAIN_MODEL=llama3.2:3b
OLLAMA_CLASSIFIER_MODEL=gemma2:2b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# Ollama server URL — default, do not change for local dev
OLLAMA_BASE_URL=http://localhost:11434

# Timeout: 30s for main LLM (Intel CPU is slow), 8s for classifier
LLM_TIMEOUT_SECONDS=30
CLASSIFIER_TIMEOUT_SECONDS=8

# ── HuggingFace Config (used when LLM_PROVIDER=huggingface) ─────
HF_API_TOKEN=hf_...your_token_here...
HF_MAIN_MODEL=mistralai/Mistral-7B-Instruct-v0.3
HF_CLASSIFIER_MODEL=google/flan-t5-large
HF_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ── LangSmith Tracing ───────────────────────────────────────────
LANGSMITH_API_KEY=lsv2_...your_key_here...
LANGSMITH_PROJECT=customer-support-agent
LANGCHAIN_TRACING_V2=true

# ── Redis (Homebrew native, no Docker) ──────────────────────────
REDIS_URL=redis://localhost:6379
REDIS_DB=0
REDIS_TTL_SECONDS=86400

# ── Chroma (in-process, no server) ──────────────────────────────
CHROMA_PERSIST_DIRECTORY=./chroma_db
CHROMA_COLLECTION_NAME=customer-memory

# ── Agent Behaviour ─────────────────────────────────────────────
BUFFER_MEMORY_SIZE=10
LONG_TERM_RETRIEVAL_K=3
CONFIDENCE_THRESHOLD=0.4
MAX_RETRIES=2
LLM_TIMEOUT_SECONDS=30

# ── App ─────────────────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO